# Base URL of the HairsUp backend (backend/.env -> PORT=4000).
# Web + iOS simulator can use localhost. On the Android emulator use
# http://10.0.2.2:4000/api, and on a physical device use your machine's LAN IP,
# e.g. http://192.168.1.5:4000/api — then restart Expo so the value is re-read.
EXPO_PUBLIC_API_URL=http://localhost:4000/api

# Same Web OAuth client ID as backend/.env's GOOGLE_CLIENT_ID (client IDs are
# public, safe to ship to the browser). Used by Google Identity Services on
# web to request an ID token, which the backend verifies against this same ID.
# In Google Cloud Console > APIs & Services > Credentials, this client must be
# type "Web application" with your dev URL (e.g. http://localhost:8081) listed
# under "Authorized JavaScript origins".
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
